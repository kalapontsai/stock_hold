# Optional Apache/PHP runtime settings.
# Copy to .env only for local use; never commit .env.
STOCK_HOLD_API_TOKEN=replac…oken
# Set to 1 to allow additional public registrations after the first account.
# STOCK_HOLD_ALLOW_REGISTRATION=0
# STOCK_HOLD_RUNTIME_DIR=D:/docker-volumn/ubuntu-apache2/runtime/stock_hold

# Update check (Settings → Maintenance → 檢查更新)
# Backend proxies the GitHub Releases API and caches the response.
# Stock_hold must be deployed from a public repo for unauthenticated
# GitHub API access (60 req/hr limit; the cache reduces this to ~1/hr).
STOCK_HOLD_UPDATE_REPO=kalapontsai/stock_hold
STOCK_HOLD_UPDATE_CACHE_TTL=3600
