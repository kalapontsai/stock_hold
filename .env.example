# Optional Apache/PHP runtime settings.
# Copy to .env only for local use; never commit .env.
# === Mandatory: API-token authentication (X-API-Token header) ===
# Generate with:  openssl rand -hex 32
# Paste the output as the value of STOCK_HOLD_API_TOKEN below.
# Leave empty to disable API-token mode entirely (X-API-Token rejected).
#
# F-01 fix: any obvious placeholder string (replace / placeholder /
# changeme / your-token / TODO / FIXME / *** / <token> etc.) is
# rejected at runtime by is_known_placeholder() in api/bootstrap.php.
# This protects against an operator who copies .env.example to .env
# verbatim — the placeholder is publicly known (repo is public), so
# leaving it set would make API-token mode bypassable by anyone who
# reads this repo. The fix is defense-in-depth: even if you replace
# with a weak secret, the placeholder check will not help you; you
# MUST run `openssl rand -hex 32` (or equivalent) and paste the result.
STOCK_HOLD_API_TOKEN=
# Set to 1 to allow additional public registrations after the first account.
# STOCK_HOLD_ALLOW_REGISTRATION=0
# STOCK_HOLD_RUNTIME_DIR=D:/docker-volumn/ubuntu-apache2/runtime/stock_hold

# F-06: per-user write rate limit (fixed window). Defaults: 60 writes / 60s.
# STOCK_HOLD_WRITE_RATE_MAX=60
# STOCK_HOLD_WRITE_RATE_WINDOW=60
# F-03: init token required for first-user bootstrap on a fresh deployment.
# Generate with: openssl rand -hex 32
# F-03: init token required for first-user bootstrap on a fresh deployment.
# Generate with:  openssl rand -hex 32   (use a DIFFERENT value from
# STOCK_HOLD_API_TOKEN above; do not reuse the same secret).
# Empty value = first-user registration disabled until you set this.
# F-01 fix: is_known_placeholder() also rejects obvious placeholder strings
# here (e.g., "replace-with-..." / "replac…oken" / "your-token" etc.).
STOCK_HOLD_INIT_TOKEN=
# F-03: register rate limit (per IP and per email). Defaults: 5 / 86400s.
# STOCK_HOLD_REGISTER_MAX_PER_DAY=5
# STOCK_HOLD_REGISTER_WINDOW=86400

# Update check (Settings → Maintenance → 檢查更新)
# Backend proxies the GitHub Releases API and caches the response.
# Stock_hold must be deployed from a public repo for unauthenticated
# GitHub API access (60 req/hr limit; the cache reduces this to ~1/hr).
STOCK_HOLD_UPDATE_REPO=kalapontsai/stock_hold
STOCK_HOLD_UPDATE_CACHE_TTL=3600

# === F-12: Cloudflare Turnstile (CAPTCHA on login/register) ===
# Get keys at: Cloudflare Dashboard → Turnstile → Add widget
#   site key (PUBLIC, safe to commit) → STOCK_HOLD_TURNSTILE_SITEKEY
#   secret key (PRIVATE, NEVER commit) → STOCK_HOLD_TURNSTILE_SECRET
#
# SITEKEY is baked into frontend/login.html at build time by scripts/package.sh
# (sed substitution of {{TURNSTILE_SITEKEY}} placeholder). Set the env var
# BEFORE running package.sh, e.g.:
#   export STOCK_HOLD_TURNSTILE_SITEKEY=*** SECRET=*** && bash scripts/package.sh
# Or inline:
#   STOCK_HOLD_TURNSTILE_SITEKEY=*** bash scripts/package.sh
#
# Leave BOTH empty to disable Turnstile (dev mode — backend skips check).
# Cloudflare's published test keys (always passes) for local dev:
#   sitekey: 1x00000000000000000000AA
#   secret:  1x0000000000000000000000000000000AA
STOCK_HOLD_TURNSTILE_SITEKEY=
STOCK_HOLD_TURNSTILE_SECRET=
