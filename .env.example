# Optional Apache/PHP runtime settings.
# Copy to .env only for local use; never commit .env.

# === Per-user API tokens (multi-tenant, migration 007) ===
# Each user manages their own API tokens via Settings \u2192 API Token.
# Tokens are stored in the `api_tokens` table (salted SHA-256 hash + first-8-char
# prefix); the raw token is shown to the user exactly once and never persisted.
# Agents / external integrations should send: -H "X-API-Token: <token>"
#
# There is NO global token anymore. If you previously set STOCK_HOLD_API_TOKEN,
# delete it from .env after migrating external integrations to per-user tokens.
#
# The legacy STOCK_HOLD_API_TOKEN env var is intentionally NOT consulted by the
# backend (F-01 / multi-tenant migration). Operators of existing deployments
# must:
#   1. Log in as each user account
#   2. Settings \u2192 API Token \u2192 "Create new token"
#   3. Copy the raw token and configure their integrations to use it.
# All previously-issued X-API-Token global tokens are now invalid.

# === F-03: public registration policy ===
# Set to 1 to allow additional public registrations after the first account.
# STOCK_HOLD_ALLOW_REGISTRATION=0

# === Per-deployment paths ===
# STOCK_HOLD_RUNTIME_DIR=D:/docker-volumn/ubuntu-apache2/runtime/stock_hold

# F-06: per-user write rate limit (fixed window). Defaults: 60 writes / 60s.
# STOCK_HOLD_WRITE_RATE_MAX=60
# STOCK_HOLD_WRITE_RATE_WINDOW=60

# === F-03: init token required for first-user bootstrap on a fresh deployment. ===
# Generate with:  openssl rand -hex 32
# Empty value = first-user registration disabled until you set this.
# F-01 fix: is_known_placeholder() rejects obvious placeholder strings
# here (e.g., "replace-with-..." / "replac\u2026oken" / "your-token" etc.).
STOCK_HOLD_INIT_TOKEN=

# === F-03: register rate limit (per IP and per email). Defaults: 5 / 86400s. ===
# STOCK_HOLD_REGISTER_MAX_PER_DAY=5
# STOCK_HOLD_REGISTER_WINDOW=86400

# === Update check (Settings \u2192 Maintenance \u2192 \u6aa2\u67e5\u66f4\u65b0) ===
# Backend proxies the GitHub Releases API and caches the response.
# Stock_hold must be deployed from a public repo for unauthenticated
# GitHub API access (60 req/hr limit; the cache reduces this to ~1/hr).
STOCK_HOLD_UPDATE_REPO=kalapontsai/stock_hold
STOCK_HOLD_UPDATE_CACHE_TTL=3600

# === F-12: Cloudflare Turnstile (CAPTCHA on login/register) ===
# Get keys at: Cloudflare Dashboard \u2192 Turnstile \u2192 Add widget
#   site key (PUBLIC, safe to commit)  \u2192 STOCK_HOLD_TURNSTILE_SITEKEY
#   secret key (PRIVATE, NEVER commit) \u2192 STOCK_HOLD_TURNSTILE_SECRET
#
# SITEKEY is baked into frontend/login.html at build time by scripts/package.sh
# (sed substitution of {{TURNSTILE_SITEKEY}} placeholder). Set the env var
# BEFORE running package.sh, e.g.:
#   export STOCK_HOLD_TURNSTILE_SITEKEY=*** && bash scripts/package.sh
# Or inline:
#   STOCK_HOLD_TURNSTILE_SITEKEY=*** bash scripts/package.sh
#
# Leave BOTH empty to disable Turnstile (dev mode \u2014 backend skips check).
# Cloudflare's published test keys (always passes) for local dev:
#   sitekey: 1x00000000000000000000AA
#   secret:  1x0000\u202600AA
STOCK_HOLD_TURNSTILE_SITEKEY=
STOCK_HOLD_TURNSTILE_SECRET=
